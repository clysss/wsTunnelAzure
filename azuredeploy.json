{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "relayScriptSource": [
      "const net = require('net');",
      "const { WebSocketServer } = require('ws');",
      "const SECRET = process.env.TUNNEL_SECRET;",
      "const WAKE_URL = process.env.WAKE_ENDPOINT_URL + '?key=' + encodeURIComponent(process.env.WAKE_KEY || '');",
      "console.log('RELAY_READY secretLen=' + (SECRET ? SECRET.length : 0) + ' wakeKeyLen=' + (process.env.WAKE_KEY ? process.env.WAKE_KEY.length : 0));",
      "let ctrl = null, wait = [], pend = new Map();",
      "const wss = new WebSocketServer({ port: 8080 });",
      "wss.on('connection', (w, r) => {",
      "  if (r.headers['x-api-key'] !== SECRET) { console.log('AUTH_FAIL'); return w.close(); }",
      "  const sid = r.headers['x-session-id'];",
      "  if (!sid) {",
      "    console.log('CTRL_OK');",
      "    ctrl = w;",
      "    w.on('close', () => { if (ctrl === w) ctrl = null; });",
      "    while (wait.length) {",
      "      const s = wait.shift();",
      "      if (!s.destroyed) w.send(JSON.stringify({ action: 'OPEN_DB', sessionId: s.id }));",
      "    }",
      "  } else {",
      "    const s = pend.get(sid);",
      "    if (!s || s.destroyed) return w.close();",
      "    pend.delete(sid);",
      "    w.on('message', d => !s.destroyed && s.write(d));",
      "    s.on('data', d => w.readyState === 1 && w.send(d));",
      "    const end = () => { try { w.close(); } catch {} try { s.destroy(); } catch {} };",
      "    w.on('close', end); s.on('close', end); s.on('error', end);",
      "    s.resume();",
      "  }",
      "});",
      "net.createServer(s => {",
      "  s.pause();",
      "  s.id = Math.random().toString(36).slice(2);",
      "  pend.set(s.id, s);",
      "  setTimeout(() => { if (pend.has(s.id)) { pend.delete(s.id); s.destroy(); } }, 6000);",
      "  if (ctrl && ctrl.readyState === 1) ctrl.send(JSON.stringify({ action: 'OPEN_DB', sessionId: s.id }));",
      "  else { wait.push(s); fetch(WAKE_URL).catch(e => console.log('WAKE_ERR', e.message)); }",
      "}).listen(3306);"
    ]
  },
  "parameters": {
    "containerGroupName": {
      "type": "string",
      "defaultValue": "mysql-tunnel-relay",
      "metadata": {
        "description": "Nom du groupe de conteneurs Azure."
      }
    },
    "dnsNameLabel": {
      "type": "string",
      "defaultValue": "[concat('mysql-relay-', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Préfixe DNS public unique. Saisissez votre label existant (ex: mysql-tunnel-relay-qqfcimd6vq5xi) si vous mettez à jour une instance existante."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Région Azure (ex: francecentral)."
      }
    },
    "wakeEndpointUrl": {
      "type": "string",
      "defaultValue": "https://votre-domaine.fr/mysql_tunnel.php",
      "metadata": {
        "description": "URL du script PHP sans paramètre ?key=."
      }
    },
    "WAKE_KEY": {
      "type": "securestring",
      "metadata": {
        "description": "Doit être strictement identique à $WAKE_KEY dans le script PHP."
      }
    },
    "TUNNEL_SECRET": {
      "type": "securestring",
      "metadata": {
        "description": "Doit être strictement identique à $TUNNEL_SECRET dans le script PHP."
      }
    }
  },
  "variables": {
    "relayScriptBase64": ""
  },
  "resources": [
    {
      "type": "Microsoft.ContainerInstance/containerGroups",
      "apiVersion": "2023-05-01",
      "name": "[parameters('containerGroupName')]",
      "location": "[parameters('location')]",
      "properties": {
        "osType": "Linux",
        "restartPolicy": "Always",
        "ipAddress": {
          "type": "Public",
          "dnsNameLabel": "[parameters('dnsNameLabel')]",
          "ports": [
            {
              "protocol": "TCP",
              "port": 3306
            },
            {
              "protocol": "TCP",
              "port": 8080
            }
          ]
        },
        "containers": [
          {
            "name": "mysql-relay",
            "properties": {
              "image": "node:20-alpine",
              "resources": {
                "requests": {
                  "cpu": 0.5,
                  "memoryInGB": 1.0
                }
              },
              "ports": [
                {
                  "protocol": "TCP",
                  "port": 3306
                },
                {
                  "protocol": "TCP",
                  "port": 8080
                }
              ],
              "environmentVariables": [
                {
                  "name": "WAKE_ENDPOINT_URL",
                  "value": "[parameters('wakeEndpointUrl')]"
                },
                {
                  "name": "WAKE_KEY",
                  "secureValue": "[parameters('WAKE_KEY')]"
                },
                {
                  "name": "TUNNEL_SECRET",
                  "secureValue": "[parameters('TUNNEL_SECRET')]"
                }
              ],
              "command": [
                "/bin/sh",
                "-c",
                "[concat('mkdir -p /app && cd /app && npm init -y >/dev/null && npm install ws && echo ', variables('relayScriptBase64'), ' | base64 -d > server.js && node server.js')]"
              ]
            }
          }
        ]
      }
    }
  ],
  "outputs": {
    "fqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerInstance/containerGroups', parameters('containerGroupName'))).ipAddress.fqdn]"
    }
  }
}
